@startuml 111
skinparam monochrome true
skinparam TableBorderColor lightblue
skinparam TableHeaderBackgroundColor lightgreen

header 教学管理系统软件接口 (部分)
footer generated by PlantUML

table {
  接口名 | 描述
  --|--
  `/api/auth/login` | 用户登录
  `/api/auth/logout` | 用户注销
  `/api/admins/<admin_id>/profile` | 获取/更新管理员个人资料
  `/api/courses` | 获取所有课程列表
  `/api/courses/<course_id>` | 获取特定课程详情
  `/api/students` | 获取所有学生列表
  `/api/students/<student_id>` | 获取特定学生详情
  `/api/grades` | 获取所有成绩或根据条件查询成绩
  `/api/assignments` | 获取所有作业或根据条件查询作业
  `/api/page/...` | 页面相关的 API 接口 (如获取页面数据)
}

@enduml
